<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WeatherKit. Needs the capability enabled on the App ID in the developer portal
	     and a paid account; without it every WeatherKit call throws and the app falls
	     back to Open-Meteo, which is why nothing here is load-bearing. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
