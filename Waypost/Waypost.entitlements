<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WeatherKit, switched off.

	     The entitlement needs a paid Apple Developer Program membership. Signing with a
	     free personal team, Xcode cannot generate a provisioning profile that carries
	     it, and the build fails before it ever reaches the code. That is Apple policy,
	     not a fault here.

	     To turn it back on: uncomment the key below, re-enable CODE_SIGN_ENTITLEMENTS in
	     project.yml, add the WeatherKit capability to the App ID in the developer
	     portal, and define PARKHOP_WEATHERKIT in the target's Swift flags.

	<key>com.apple.developer.weatherkit</key>
	<true/>
	-->

	<!-- The app group the widget saves through, switched off for the same reason.

	     It must match WaypostWidgets/WaypostWidgets.entitlements exactly, and both
	     targets need PARKHOP_APP_GROUP defined, or the app and the widget keep two
	     separate saved lists and neither knows about the other.

	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.us.parkhop.waypost</string>
	</array>
	-->
</dict>
</plist>
