# The Xcode project is generated from project.yml by xcodegen — never committed, so
# project.pbxproj can't become a merge battleground.
Waypost.xcodeproj/
*.xcworkspace/

# Build output
build/
DerivedData/
*.ipa
*.dSYM.zip

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store

# Word lock files
~$*

# Seeded design canvases are generated from the .dc.html sources beside them
# (~2 MB of packaged editor each) — the sources are what is kept.
design/**/*.html
!design/**/*.dc.html
